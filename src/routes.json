    {
      "component": "paymentHistoryLink",
      "name": "payment-history-link",
      "slot": "billing-dashboard-actions-slot"
    },
    {
      "component": "billManagerLink",
      "name": "bill-manager-link",
      "slot": "billing-dashboard-actions-slot"
